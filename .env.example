# Copy this file to `.env` and add your own key.
# Get one from https://aistudio.google.com/apikey

PDF_MARKDOWN_KEY=your_gemini_api_key_here

# GEMINI_API_KEY and GOOGLE_API_KEY are also accepted as fallbacks.

# --- Optional server settings ---
# The API is unauthenticated. Keep it on loopback unless you have your own auth in front.
# GOOSEQUILL_HOST=127.0.0.1
# GOOSEQUILL_PORT=8000

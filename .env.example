# Copy this file to `.env` and add your own key.
# Get one from https://aistudio.google.com/apikey

PDF_MARKDOWN_KEY=your_gemini_api_key_here

# GEMINI_API_KEY and GOOGLE_API_KEY are also accepted as fallbacks.

# --- Optional server settings ---
# The API is unauthenticated. Keep it on loopback unless you have your own auth in front.
# GOOSEQUILL_HOST=127.0.0.1
# GOOSEQUILL_PORT=8000

# --- Where your documents get processed -------------------------------------
# By default GooseQuill uses the Gemini Developer API, which is a GLOBAL
# endpoint: you don't choose the territory your documents are processed in.
#
# For documents that must stay in the EEA, switch to Vertex AI's EU
# multi-region residency endpoint. You need a Google Cloud project and an API
# key belonging to it; there is no service account or gcloud login involved.
#
# GOOSEQUILL_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_API_KEY=your_project_scoped_key
#
# Defaults you only need to change to leave the EEA:
#   GOOGLE_CLOUD_LOCATION=eu                                  (the EU multi-region)
#   GOOSEQUILL_VERTEX_HOST=https://aiplatform.eu.rep.googleapis.com
#
# It must be the MULTI-region ("eu"), not a single region like europe-west4:
# several Flash-Lite models are served in the US and EU multi-regions only.
# Note the hostname shape — ".rep.", not a "{region}-" prefix.
#
# Batch jobs are not available on Vertex (they need the Gemini File API).
